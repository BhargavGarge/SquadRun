{
  "expo": {
    "name": "Squad Goals",
    "slug": "squad-goals",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "black"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.squadgoals.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Squad Goals to access your camera for profile photo.",
        "NSPhotoLibraryUsageDescription": "Allow Squad Goals to access your photos for profile photo.",
        "NSLocationWhenInUseUsageDescription": "Squad Goals uses your location to track your running route.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Squad Goals uses your location to track your running route.",
        "NSMotionUsageDescription": "Squad Goals counts your steps to track your activity."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080812"
      },
      "package": "com.squadgoals.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "NOTIFICATIONS",
        "VIBRATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACTIVITY_RECOGNITION"
      ],
      "useNextNotificationsApi": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7C3AED",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Squad Goals to access your photos."
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Squad Goals uses your location to track your running route."
        }
      ]
    ],
    "scheme": "squad-goals",
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      },
      "googleMapsApiKey": "",
      "appleMapsApiKey": ""
    }
  }
}
